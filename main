// Constants
const SHEET_NAMES = {
    RAW: 'Raw',
    EMPLOYEES: 'Nhân sự',
    ATTENDANCE: 'Chấm công',
    LOGS: 'Logs'
};

const MAX_PAID_LEAVE_DAYS = 5;
const MAX_WFH_DAYS = 4;

// Utility Functions
function getCurrentMonthYear(date) {
    const now = date ? new Date(date) : new Date(); // If check old month, edit new Date() here
    return {
        // month: date ? now.getMonth() : 10, 
        month: now.getMonth() + 1,
        year: now.getFullYear()
    };
}

function getSheetByName(sheetName) {
    const ss = SpreadsheetApp.getActiveSpreadsheet();
    return ss.getSheetByName(sheetName);
}

function logMessage(message) {
    const logsSheet = getSheetByName(SHEET_NAMES.LOGS);
    if (!logsSheet) return;

    const now = new Date();
    Logger.log(message);
    logsSheet.appendRow([now, message]);
}

function formatDate(date) {
    return Utilities.formatDate(date, Session.getScriptTimeZone(), "dd/MM/yyyy");
}


function isWeekend(date) {
    const day = date.getDay();
    return day === 0 || day === 6; // 0 is Sunday, 6 is Saturday
}


function getAttendanceSheetName() {
    const { month, year } = getCurrentMonthYear();
    return `Chấm công - ${month}/${year}`;
}

function getOldAttendanceSheetName() {
    const { month, year } = getCurrentMonthYear();
    return `Chấm công - ${month - 1}/${year}`;
}
// function test() {
//   const reuslt = calculateLeaveDays({
//     startDate: new Date('2025-08-10'),
//     startShift: 'Cả ngày',
//     endDate: '',
//     endShift: undefined
//   })
//   console.log(reuslt)
// }
function calculateLeaveDays(request) {
    const startDate = request.startDate;
    const startShift = request.startShift;

    if (!request.endDate) {
        if (startShift === 'Cả ngày') return isWeekend(startDate) ? 0 : 1;
        return isWeekend(startDate) ? 0 : 0.5;
    }

    const endDate = request.endDate;
    const endShift = request.endShift;

    // Calculate total days between dates, excluding weekends
    let totalDays = 0;
    const currentDate = new Date(startDate);

    // we got issued, when endDate = currentDate and no endShift -> totalDays = 1;
    while (currentDate <= endDate) {
        if (!isWeekend(currentDate)) {
            totalDays++;
        }
        currentDate.setDate(currentDate.getDate() + 1);
    }

    // Adjust for shifts
    if (startShift === 'Chiều' && !isWeekend(startDate)) totalDays -= 0.5;
    else if ((!endShift || endShift === 'Sáng') && startShift !== 'Cả ngày' && !isWeekend(endDate)) totalDays -= 0.5; // in case have endDate but not endShift

    return Math.abs(totalDays);
}

function getRejectionReason(employee, request) {
    const reasons = [];

    if (!employee.isOfficial) {
        reasons.push("Nhân viên chưa chính thức");
        return reasons.join(", ");
    }
    if (!employee.isWorking) {
        reasons.push("Nhân viên không còn làm việc");
        return reasons.join(", ");
    }
    if (!request.approvedBy || !request.approvedBy.includes('@nerdlabs.tech')) {
        reasons.push("Chưa được duyệt");
        return reasons.join(", ");
    }
    return null;
}


// Main Processing Functions
function collectLeaveRequests() {
    const rawSheet = getSheetByName(SHEET_NAMES.RAW);
    if (!rawSheet) {
        logMessage('Error: Raw sheet not found');
        return [];
    }

    const { month, year } = getCurrentMonthYear();
    const data = rawSheet.getDataRange().getValues();

    // Skip header row
    const requests = [];
    for (let i = 1; i < data.length; i++) {
        const row = data[i];
        const requestDate = new Date(row[7]); // Column H: Thời gian xin phép bắt đầu

        // Only process requests for current month/year
        if (requestDate.getMonth() + 1 === month && requestDate.getFullYear() === year) {
            requests.push({
                stt: row[0], // Column A: STT
                type: row[1], // Column B: Loại Hình
                requester: row[2], // Column C: Người Gửi
                manager: row[3], // Column D: Quản Lý
                reason: row[4], // Column E: Lý Do
                description: row[5], // Column F: Mô tả
                leaveMinutes: row[6], // Column G: Số phút đi muộn/về sớm
                startDate: new Date(row[7]), // Column H: Thời gian xin phép bắt đầu
                startShift: row[8], // Column I: Ca xin phép bắt đầu
                endDate: row[9] ? new Date(row[9]) : null, // Column J: Thời gian xin phép kết thúc
                endShift: row[10] || null, // Column K: Ca xin phép kết thúc
                createdAt: new Date(row[11]), // Column L: Tạo lúc
                approvedBy: row[12] || null, // Column M: Duyệt bởi
                approvedAt: row[13] ? new Date(row[13]) : null, // Column N: Duyệt lúc,
                isRevoked: row[14] === 'Yes'
            });
        }
    }

    return requests;
}

function buildEmployeeMap() {
    const employeeSheet = getSheetByName(SHEET_NAMES.EMPLOYEES);
    const olderAttendanceSheetName = getOldAttendanceSheetName();
    const olderAttendanceSheet = getSheetByName(olderAttendanceSheetName);

    if (!employeeSheet) {
        logMessage('Error: Required Nhân Sự sheets not found');
        return new Map();
    }

    if (!olderAttendanceSheet) {
        logMessage('Error: Required old Chấm Công sheets not found');
        return new Map();
    }

    const employeeData = employeeSheet.getDataRange().getValues();
    const olderAttendanceData = olderAttendanceSheet.getDataRange().getValues();
    const employeeMap = new Map();

    // Create a map of email to remaining leave days from attendance sheet
    const leaveDaysMap = new Map();
    for (let i = 1; i < olderAttendanceData.length; i++) {
        const row = olderAttendanceData[i];

        const email = row[0]; // Column A: Email
        const remainingLeaveDays = row[9] || 0; // Column J: Phép năm (còn lại)

        leaveDaysMap.set(email, remainingLeaveDays);
    }

    // Build employee map with leave days from attendance sheet
    for (let i = 1; i < employeeData.length; i++) {
        const row = employeeData[i];
        const email = row[3]; // Column D: Email
        const name = row[1]; // Column B: Name

        const isWorking = row[5] === 'Yes'
        if (!isWorking) continue;

        employeeMap.set(email, {
            name: name,
            email: email,
            isOfficial: row[4] === 'Yes', // Column E: Official
            isWorking, // Column F: Status
            onboardDate: new Date(row[6]), // Column G: Onboard Date
            offboardDate: new Date(row[7]), // Column H: Offboard Date
            remainingLeaveDays: row[4] === 'Yes' ? leaveDaysMap.get(email) + 1 : 0
        });
    }

    return employeeMap;
}

function processLeaveRequests() {
    const requests = collectLeaveRequests();
    const employeeMap = buildEmployeeMap();
    const processedLeaves = new Map();
    let totalWorkDays = calculateTotalWorkDays();

    employeeMap.forEach(employee => {
        const defaultValues = {
            employeeEmail: employee.email,
            paidLeaveDays: 0,
            unpaidLeaveDays: 0,
            legalLeaveDays: 0,
            earlyLeave: 0,
            late: 0,
            wfhDays: 0,
            totalWorkDays: 0,
            remainingPaidDays: employee.remainingLeaveDays,
            comments: {
                'Nghỉ phép': [],
                'Nghỉ đặc biệt': [],
                'Về sớm': [],
                'Nghỉ không lương': [],
                'WFH': [],
                'Đi muộn': []
            }
        }

        if (!employee.isWorking) {
            return;
        }

        processedLeaves.set(employee.email, defaultValues);

    })

    // Group requests by employee
    requests.forEach(request => {
        // logMessage(`${new Date()} Processing request: ${request.requester} - ${request.type}`)
        if (request.isRevoked) {
            return;
        }

        const employee = employeeMap.get(request.requester);

        if (!employee) {
            logMessage(`Error: Employee not found for ${request.requester}`);
            return;
        }

        if (!employee.isWorking) {
            return;
        }

        const processedLeave = processedLeaves.get(request.requester);
        const leaveDays = calculateLeaveDays(request);

        const rejectionReason = getRejectionReason(employee, request);

        // Handle different types of leave/attendance
        switch (request.type) {
            case 'Nghỉ phép':
                if (!rejectionReason) {
                    const remainingPaidDays = Math.min(
                        MAX_PAID_LEAVE_DAYS - processedLeave.paidLeaveDays,
                        employee.remainingLeaveDays
                    );

                    if (remainingPaidDays >= leaveDays) {
                        processedLeave.paidLeaveDays += leaveDays;
                        employee.remainingLeaveDays -= leaveDays;
                        processedLeave.comments['Nghỉ phép'].push(
                            `${formatDate(request.startDate)} - ${leaveDays} ngày - Có lương`
                        );
                    } else if (remainingPaidDays > 0) {
                        processedLeave.paidLeaveDays += remainingPaidDays;
                        processedLeave.unpaidLeaveDays += (leaveDays - remainingPaidDays);
                        employee.remainingLeaveDays -= remainingPaidDays;
                        processedLeave.comments['Nghỉ phép'].push(
                            `${formatDate(request.startDate)} - ${leaveDays} ngày - ${remainingPaidDays} ngày có lương, ${(leaveDays - remainingPaidDays)} ngày không lương`
                        );
                    } else {
                        processedLeave.unpaidLeaveDays += leaveDays;
                        processedLeave.comments['Nghỉ phép'].push(
                            `${formatDate(request.startDate)} - ${leaveDays} ngày - Không lương (hết phép năm)`
                        );
                    }
                    processedLeave.remainingPaidDays = employee.remainingLeaveDays;
                } else {
                    processedLeave.unpaidLeaveDays += leaveDays;
                    processedLeave.comments['Nghỉ phép'].push(
                        `${formatDate(request.startDate)} - ${leaveDays} ngày - Không lương (${rejectionReason})`
                    );
                }
                break;

            case 'Về sớm':
                processedLeave.earlyLeave += 1;
                processedLeave.comments['Về sớm'].push(
                    `${formatDate(request.startDate)} ${request.leaveMinutes} phút`
                );
                break;

            case 'Nghỉ không lương':
                processedLeave.unpaidLeaveDays += leaveDays;
                processedLeave.comments['Nghỉ không lương'].push(
                    `${formatDate(request.startDate)} ${leaveDays} ngày`
                );
                break;

            case 'Nghỉ đặc biệt':
                processedLeave.legalLeaveDays += leaveDays;
                processedLeave.comments['Nghỉ đặc biệt'].push(
                    `${formatDate(request.startDate)} ${leaveDays} ngày`
                );
                break;

            case 'WFH':
                // Check if WFH days exceed the limit
                if (processedLeave.wfhDays + leaveDays >= MAX_WFH_DAYS) {
                    const remainingWFHDays = MAX_WFH_DAYS - processedLeave.wfhDays;
                    if (remainingWFHDays > 0) {
                        processedLeave.wfhDays += remainingWFHDays;
                        processedLeave.unpaidLeaveDays += (leaveDays - remainingWFHDays);
                        processedLeave.comments['WFH'].push(
                            `${formatDate(request.startDate)} ${leaveDays} ngày - Chỉ được duyệt ${remainingWFHDays} ngày (vượt quá giới hạn ${MAX_WFH_DAYS} ngày)`
                        );
                    } else {
                        processedLeave.unpaidLeaveDays += leaveDays;
                        processedLeave.comments['WFH'].push(
                            `${formatDate(request.startDate)} ${leaveDays} ngày - Không được duyệt (đã vượt quá giới hạn ${MAX_WFH_DAYS} ngày)`
                        );
                    }
                } else {
                    processedLeave.wfhDays += leaveDays;
                    processedLeave.comments['WFH'].push(
                        `${formatDate(request.startDate)} ${leaveDays} ngày`
                    );
                }
                break;

            case 'Đi muộn':
                processedLeave.late += 1;
                processedLeave.comments['Đi muộn'].push(
                    `${formatDate(request.startDate)} ${request.leaveMinutes} phút`
                );
                break;
        }
    });
    // Calculate final total work days after processing all leaves
    employeeMap.forEach((employee) => {
        const leave = processedLeaves.get(employee.email);

        if (!employee.isWorking) {
            leave.totalWorkDays = 0;
        } else {
            const { month: sheetMonth, year: sheetYear } = getCurrentMonthYear();
            const { month: offboardMonth, year: offboardYear } = getCurrentMonthYear(employee.offboardDate)
            const { month: onboardMonth, year: onboardYear } = getCurrentMonthYear(employee.onboardDate)


            const isOffboardThisMonth = sheetMonth === offboardMonth && sheetYear === offboardYear;
            const isOnboardThisMonth = sheetMonth === onboardMonth && sheetYear === onboardYear;

            if (isOnboardThisMonth && isOffboardThisMonth) {
                leave.totalWorkDays = calculateTotalWorkDays(employee.onboardDate, employee.offboardDate) - leave.unpaidLeaveDays;
            } else if (isOnboardThisMonth) {
                leave.totalWorkDays = calculateTotalWorkDays(employee.onboardDate) - leave.unpaidLeaveDays;
            } else if (isOffboardThisMonth) {
                leave.totalWorkDays = calculateTotalWorkDays(null, employee.offboardDate) - leave.unpaidLeaveDays;
            } else {
                leave.totalWorkDays = totalWorkDays - leave.unpaidLeaveDays;
            }
        }

        processedLeaves.set(employee.email, leave);
    });

    return processedLeaves;
}

function calculateTotalWorkDays(startDate, endDate) {
    const { month, year } = getCurrentMonthYear();
    const lastDay = !isNaN(new Date(endDate).getTime()) ? new Date(endDate).getDate() : new Date(year, month, 0).getDate();
    const startDay = startDate ? new Date(startDate).getDate() : new Date(year, month - 1, 1).getDate()

    let totalWorkDays = 0;

    for (let day = startDay; day <= lastDay; day++) {
        const date = new Date(year, month - 1, day);
        const dayOfWeek = date.getDay();
        // Skip weekends (0 = Sunday, 6 = Saturday)
        if (dayOfWeek !== 0 && dayOfWeek !== 6) {
            totalWorkDays++;
        }
    }

    return totalWorkDays;
}

function clearAttendanceSheet(sheet) {
    // Clear all rows except header
    if (sheet.getLastRow() > 1) {
        sheet.deleteRows(2, sheet.getLastRow() - 1);
    }

    // Clear all comments
    const range = sheet.getRange(1, 1, sheet.getLastRow(), sheet.getLastColumn());
    range.clearNote();
}

function updateAttendanceSheet(processedLeaves) {
    const attendanceSheetName = getAttendanceSheetName();
    let attendanceSheet = getSheetByName(attendanceSheetName);

    // Get employee data using buildEmployeeMap
    const employeeMap = buildEmployeeMap();
    logMessage(`Total employees from buildEmployeeMap: ${employeeMap.size}`);

    // Calculate total work days for the month
    const totalWorkDays = calculateTotalWorkDays();
    logMessage(`totalWorkDays ${totalWorkDays}`);

    // Create new sheet if doesn't exist
    if (!attendanceSheet) {
        const ss = SpreadsheetApp.getActiveSpreadsheet();
        attendanceSheet = ss.insertSheet(attendanceSheetName);

        // Set up headers
        const headers = [
            'Email',
            'Họ tên',
            'WFH',
            'Nghỉ không lương',
            'Nghỉ đặc biệt',
            'Nghỉ phép',
            'Đi muộn',
            'Về sớm',
            'Tổng đi muộn/về sớm',
            'Tổng công',
            'Phép năm (còn lại)'
        ];
        attendanceSheet.getRange(1, 1, 1, headers.length).setValues([headers]);

        // Format header row
        attendanceSheet.getRange(1, 1, 1, headers.length)
            .setBackground('#f3f3f3')
            .setFontWeight('bold')
            .setHorizontalAlignment('center');

        // Freeze header row
        attendanceSheet.setFrozenRows(1);

        // Protect the sheet
        const protection = attendanceSheet.protect();
        protection.setDescription('Protected Attendance Sheet');
        protection.setDomainEdit(false);
        protection.setUnprotectedRanges([]); // Make entire sheet protected
    } else {
        // Clear existing data and comments
        clearAttendanceSheet(attendanceSheet);

        // Ensure header row is frozen
        attendanceSheet.setFrozenRows(1);

        // Remove existing protection if any
        const protections = attendanceSheet.getProtections(SpreadsheetApp.ProtectionType.SHEET);
        protections.forEach(protection => protection.remove());

        // Add new protection
        const protection = attendanceSheet.protect();
        protection.setDescription('Protected Attendance Sheet');
        protection.setDomainEdit(false);
        protection.setUnprotectedRanges([]); // Make entire sheet protected
    }

    // Fill all employees with default values
    const defaultValues = [];
    let employeeCount = 0;

    employeeMap.forEach((employee, email) => {
        // logMessage(`Writting employee: ${email} - ${employee.name}`);
        if (!employee.isWorking) {
            return;
        }
        defaultValues.push([
            email,
            employee.name,
            0, // WFH
            0, // Nghỉ không lương
            0, // Nghỉ đặc biệt (theo luật lao động)
            0, // Nghỉ phép
            0, // Đi muộn
            0, // Về sớm
            0, // Tổng đi muộn + về sớm
            0, // Tổng công
            employee.remainingLeaveDays // Phép năm (còn lại)
        ]);
        employeeCount++;
    });

    logMessage(`Total employees processed: ${employeeCount}`);

    if (defaultValues.length > 0) {
        try {
            attendanceSheet.getRange(2, 1, defaultValues.length, defaultValues[0].length)
                .setValues(defaultValues);
            logMessage(`Successfully wrote ${defaultValues.length} rows to sheet`);
        } catch (error) {
            logMessage(`Error writing to sheet: ${error.toString()}`);
        }
    } else {
        logMessage('Warning: No default values to write to sheet');
    }

    // Get existing data
    const data = attendanceSheet.getDataRange().getValues();
    logMessage(`Total rows in sheet after update: ${data.length}`);
    const existingEmails = new Set(data.slice(1).map(row => row[0])); // Skip header row
    logMessage(`Existing emails count: ${existingEmails.size}`);

    // Process each leave record
    processedLeaves.forEach((leave, email) => {
        let row;
        const employee = employeeMap.get(email);

        if (!employee) {
            logMessage(`Warning: Employee not found for email ${email}`);
            return;
        }

        // if (leave.totalWorkDays <= 0) {
        //   return;
        // }

        // Find or create row for employee
        if (existingEmails.has(email)) {
            row = data.findIndex((row, index) => index > 0 && row[0] === email) + 1;
        } else {
            // Add new row for employee
            row = attendanceSheet.getLastRow() + 1;
            attendanceSheet.getRange(row, 1, 1, 2).setValues([[email, employee.name]]);
            existingEmails.add(email);
        }

        // Update attendance data

        // WFH (Column C)
        const wfhCell = attendanceSheet.getRange(row, 3);
        wfhCell.setValue(leave.wfhDays);
        const shouldHighlightWfh = leave.wfhDays >= MAX_WFH_DAYS;
        if (shouldHighlightWfh) {
            // Calculate red intensity based on how much WFH days exceed the threshold
            const redIntensity = Math.min(255, Math.max(0, Math.floor((20 - leave.wfhDays) * 12))); // Inverted: 20 is lightest, 7 is boldest
            const redHex = redIntensity.toString(16).padStart(2, '0');
            wfhCell.setBackground(`#ff${redHex}${redHex}`);
            wfhCell.setFontWeight('bold');
        }

        // Nghỉ không lương (Column D)
        const unpaidLeaveCell = attendanceSheet.getRange(row, 4);
        unpaidLeaveCell.setValue(leave.unpaidLeaveDays);
        const shouldHighlightUnpaid = leave.unpaidLeaveDays > MAX_PAID_LEAVE_DAYS;
        if (shouldHighlightUnpaid) {
            unpaidLeaveCell.setBackground('#ffebee');
            unpaidLeaveCell.setFontWeight('bold');
        }

        // Nghỉ đặc biệt (Column E)
        const legalLeaveCell = attendanceSheet.getRange(row, 5);
        legalLeaveCell.setValue(leave.legalLeaveDays);


        // Nghỉ phép (Column F)
        const paidLeaveCell = attendanceSheet.getRange(row, 6);
        paidLeaveCell.setValue(leave.paidLeaveDays);
        const shouldHighlightPaid = leave.paidLeaveDays > MAX_PAID_LEAVE_DAYS;
        if (shouldHighlightPaid) {
            paidLeaveCell.setBackground('#ffebee');
            paidLeaveCell.setFontWeight('bold');
        }

        // Đi muộn (Column G)
        const lateCell = attendanceSheet.getRange(row, 7);
        lateCell.setValue(leave.late);
        const shouldHighlightLate = leave.late >= 5;
        if (shouldHighlightLate) {
            const redIntensity = Math.min(255, Math.max(0, Math.floor((20 - leave.late) * 12))); // Inverted: 20 is lightest, 7 is boldest
            const redHex = redIntensity.toString(16).padStart(2, '0');
            lateCell.setBackground(`#ff${redHex}${redHex}`);
            lateCell.setFontWeight('bold');
        }

        // Về sớm (Column H)
        const earlyLeaveCell = attendanceSheet.getRange(row, 8);
        earlyLeaveCell.setValue(leave.earlyLeave);
        const shouldHighlightEarly = leave.earlyLeave >= 5;
        if (shouldHighlightEarly) {
            const redIntensity = Math.min(255, Math.max(0, Math.floor((20 - leave.earlyLeave) * 12))); // Inverted: 20 is lightest, 7 is boldest
            const redHex = redIntensity.toString(16).padStart(2, '0');
            earlyLeaveCell.setBackground(`#ff${redHex}${redHex}`);
            earlyLeaveCell.setFontWeight('bold');
        }

        // Tổng đi muộn + về sớm (I)
        const totalLeaveSuddenly = leave.earlyLeave + leave.late;
        const totalLeaveSuddenlyCell = attendanceSheet.getRange(row, 9);
        totalLeaveSuddenlyCell.setValue(totalLeaveSuddenly);
        const shouldHighlightLeaveSuddenly = totalLeaveSuddenly >= 5;
        if (shouldHighlightLeaveSuddenly) {
            const redIntensity = Math.min(255, Math.max(0, Math.floor((20 - totalLeaveSuddenly) * 12))); // Inverted: 20 is lightest, 7 is boldest
            const redHex = redIntensity.toString(16).padStart(2, '0');
            totalLeaveSuddenlyCell.setBackground(`#ff${redHex}${redHex}`);
            totalLeaveSuddenlyCell.setFontWeight('bold');
        }

        // Tổng công (Column J)
        const totalWorkCell = attendanceSheet.getRange(row, 10);
        totalWorkCell.setValue(leave.totalWorkDays);


        // Phép năm (còn lại) (Column K)
        const remainingPaidCell = attendanceSheet.getRange(row, 11);
        remainingPaidCell.setValue(leave.remainingPaidDays);


        // Add comment to the cell with all types of leave/attendance
        const allComments = [];
        Object.entries(leave.comments).forEach(([type, comments]) => {
            if (comments.length > 0) {
                allComments.push(`\n${type}:`);
                allComments.push(...comments);
            }
        });
        if (allComments.length > 0) {
            const employeeCell = attendanceSheet.getRange(row, 2); // Column B: Họ tên
            employeeCell.setComment(allComments.join('\n'));
        }
    });

    // Auto-resize columns for better readability
    attendanceSheet.autoResizeColumns(1, 9);
}

function main() {
    try {
        // Process leave requests
        const processedLeaves = processLeaveRequests();
        updateAttendanceSheet(processedLeaves);

        logMessage('Successfully processed leave requests');
    } catch (error) {
        logMessage(`Error: ${error.toString()}`);
    }
}

// ============================================
// TELEGRAM BOT API ENDPOINTS
// ============================================

function doPost(e) {
    try {
        const data = JSON.parse(e.postData.contents);
        const action = data.action;

        let result;
        switch (action) {
            case 'get_employee_by_telegram':
                result = getEmployeeByTelegram(data.telegram_username);
                break;
            case 'get_employees':
                result = getAllEmployees();
                break;
            case 'approve_leave':
                result = writeApprovedLeave(data);
                break;
            default:
                result = { success: false, error: 'Unknown action' };
        }

        return ContentService.createTextOutput(JSON.stringify(result))
            .setMimeType(ContentService.MimeType.JSON);
    } catch (error) {
        return ContentService.createTextOutput(JSON.stringify({
            success: false,
            error: error.toString()
        })).setMimeType(ContentService.MimeType.JSON);
    }
}

function getEmployeeByTelegram(telegramUsername) {
    const employeeSheet = getSheetByName(SHEET_NAMES.EMPLOYEES);
    if (!employeeSheet) {
        return { success: false, error: 'Employee sheet not found' };
    }

    const data = employeeSheet.getDataRange().getValues();
    const headers = data[0];

    // Find column indexes (adjust based on your actual column structure)
    // Assuming: A=STT, B=Name, C=?, D=Email, E=Official, F=Working, G=Onboard, H=Offboard, I=Telegram, J=Manager Email
    const telegramColIndex = headers.findIndex(h =>
        h.toString().toLowerCase().includes('telegram')
    );
    const managerColIndex = headers.findIndex(h =>
        h.toString().toLowerCase().includes('manager') || h.toString().toLowerCase().includes('quản lý')
    );

    // Default column positions if not found by header
    const TELEGRAM_COL = telegramColIndex >= 0 ? telegramColIndex : 8; // Column I (0-indexed)
    const MANAGER_COL = managerColIndex >= 0 ? managerColIndex : 9;   // Column J (0-indexed)

    for (let i = 1; i < data.length; i++) {
        const row = data[i];
        const rowTelegram = row[TELEGRAM_COL];

        if (rowTelegram && rowTelegram.toString().toLowerCase() === telegramUsername.toLowerCase()) {
            return {
                success: true,
                employee: {
                    name: row[1],           // Column B: Name
                    email: row[3],          // Column D: Email
                    telegram: rowTelegram,
                    manager_email: row[MANAGER_COL] || '',
                    is_official: row[4] === 'Yes',
                    is_working: row[5] === 'Yes'
                }
            };
        }
    }

    return { success: false, employee: null };
}

function getAllEmployees() {
    const employeeSheet = getSheetByName(SHEET_NAMES.EMPLOYEES);
    if (!employeeSheet) {
        return { success: false, error: 'Employee sheet not found' };
    }

    const data = employeeSheet.getDataRange().getValues();
    const headers = data[0];

    // Find column indexes
    const telegramColIndex = headers.findIndex(h =>
        h.toString().toLowerCase().includes('telegram')
    );
    const managerColIndex = headers.findIndex(h =>
        h.toString().toLowerCase().includes('manager') || h.toString().toLowerCase().includes('quản lý')
    );

    const TELEGRAM_COL = telegramColIndex >= 0 ? telegramColIndex : 8;
    const MANAGER_COL = managerColIndex >= 0 ? managerColIndex : 9;

    const employees = [];
    for (let i = 1; i < data.length; i++) {
        const row = data[i];
        if (row[5] !== 'Yes') continue; // Skip non-working employees

        employees.push({
            name: row[1],
            email: row[3],
            telegram: row[TELEGRAM_COL] || '',
            manager_email: row[MANAGER_COL] || ''
        });
    }

    return { success: true, employees };
}

function writeApprovedLeave(data) {
    const rawSheet = getSheetByName(SHEET_NAMES.RAW);
    if (!rawSheet) {
        return { success: false, error: 'Raw sheet not found' };
    }

    // Get next STT
    const lastRow = rawSheet.getLastRow();
    const nextSTT = lastRow > 0 ? lastRow : 1;

    // Parse dates
    const startDate = new Date(data.start_date);
    const endDate = data.end_date ? new Date(data.end_date) : '';
    const createdAt = data.created_at ? new Date(data.created_at) : new Date();
    const approvedAt = data.approved_at ? new Date(data.approved_at) : new Date();

    // Append row to Raw sheet
    // Columns: STT, Loại Hình, Người Gửi, Quản Lý, Lý Do, Mô tả, Số phút,
    //          Thời gian bắt đầu, Ca bắt đầu, Thời gian kết thúc, Ca kết thúc,
    //          Tạo lúc, Duyệt bởi, Duyệt lúc, Revoked
    rawSheet.appendRow([
        nextSTT,                              // A: STT
        data.leave_type,                      // B: Loại Hình
        data.employee_email,                  // C: Người Gửi
        data.manager_email,                   // D: Quản Lý
        data.reason,                          // E: Lý Do
        'Submitted via Telegram Bot',         // F: Mô tả
        '',                                   // G: Số phút đi muộn/về sớm
        startDate,                            // H: Thời gian xin phép bắt đầu
        data.start_shift,                     // I: Ca xin phép bắt đầu
        endDate,                              // J: Thời gian xin phép kết thúc
        data.end_shift || '',                 // K: Ca xin phép kết thúc
        createdAt,                            // L: Tạo lúc
        data.approved_by,                     // M: Duyệt bởi
        approvedAt,                           // N: Duyệt lúc
        'No'                                  // O: Revoked
    ]);

    logMessage(`Telegram Bot: Approved leave for ${data.employee_email} - ${data.leave_type}`);

    return { success: true };
} 